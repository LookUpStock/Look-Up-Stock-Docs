@startuml aktivitaetsdiagramm_us-04_v1
' LookUpStock – Aktivitätsdiagramm zur Kern-Story US-04
' Issue #21 · Sprint 1 · Stand 30.09.2026
' Grundlagen: Kurzformat-Tabelle US-04 (kurzformat_sprint-1.md),
'             API-Design (finale Fassung, 30.09.2026), POST /simulations
' Werkzeug: PlantUML

skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #333333
skinparam ActivityDiamondBackgroundColor #F5F5F5
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #999999
skinparam SwimlaneTitleFontStyle bold

title Aktivitätsdiagramm US-04 – Monte-Carlo-Simulation durchführen (v1, Sprint 1)

|Nutzer|
start
:Portfolio auswählen;

repeat
  :Startkapital, monatliche Sparrate und
  Anlagehorizont eingeben;
  :optional Pfadanzahl und Seed festlegen;
  :Simulation starten;
  |LookUpStock (System)|
  :Eingaben prüfen;
  note right
    **Prüfregeln (PO-Festlegungen 3–6)**
    • Startkapital und Sparrate: Pflicht, ≥ 0,
      nicht beide 0
    • Anlagehorizont: 1 bis 40 ganze Jahre
    • Pfadanzahl (optional): 1.000 bis 50.000,
      Standard 10.000
    • Seed (optional): ganze Zahl
  end note
  backward :Fehlermeldung zum ungültigen Feld anzeigen
  (HTTP 400 VALIDATION_ERROR);
repeat while () is ([Eingaben ungültig]) not ([Eingaben gültig])

:Portfolio laden;
if () then ([vorhanden])
else ([nicht vorhanden])
  :Meldung „Portfolio nicht gefunden.“ anzeigen
  (HTTP 404 NOT_FOUND);
  stop
endif

if () then ([ohne Seed])
  :Zufälligen Seed erzeugen;
else ([mit Seed])
endif

:Historische Kursdaten der
enthaltenen Anlagen anfordern;

|Finanzdaten-API|
:Kursdaten bereitstellen;

|LookUpStock (System)|
if () then ([verfügbar])
else ([nicht verfügbar])
  :Meldung anzeigen:
  „Kursdaten sind gerade nicht verfügbar.“
  (HTTP 503 UPSTREAM_UNAVAILABLE);
  stop
endif

:Kurshistorie je Anlage prüfen;
if () then ([≥ 3 Jahre])
else ([< 3 Jahre])
  :Meldung mit betroffener Anlage anzeigen:
  „Für eine Anlage liegen weniger als
  3 Jahre Kursdaten vor.“
  (HTTP 422 INSUFFICIENT_DATA);
  stop
endif

:Rendite und Volatilität
je Anlage schätzen;
:Wertverläufe in Monatsschritten simulieren
(gewählte Pfadanzahl, Seed);
:5., 50. und 95. Perzentil
je Monat berechnen;
:Fächerdiagramm und
verwendeten Seed anzeigen;

|Nutzer|
:Ergebnis ansehen;
stop

legend bottom left
  **Nicht enthalten (Stand Sprint 1):** Anmeldung (US-01, Sprint 2) · Zielbetrag und Kennzahlen (US-05, Sprint 2)
  · Speichern der Simulation (US-08, Sprint 3)
  Angaben „HTTP …“ = Antwort von POST /simulations laut API-Design
endlegend

@enduml
