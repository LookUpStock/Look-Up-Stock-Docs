@startuml klassendiagramm_v5
' LookUpStock – Klassendiagramm v5 (Backend)
' Sprint 4 · Stand 25.10.2026
' Grundlagen: Backend-Code (main, Stand 25.10.2026: zusätzlich BE #89, BE #93, BE #94, BE #102 gemergt),
'             Klassendiagramm v4, ADR-01 bis ADR-06, API-Design, schema.graphqls
' Änderungen gegenüber v4:
'   - Neu (US-09, BE #93): DemoController, DemoService, DemoPortfolio mit Position;
'     Beispielportfolios im Code, Anlagen URTH/IEMG (NYSE Arca, F3)
'   - Neu (GraphQL lesend, BE #94): QueryController, AuthTokenInterceptor, GraphQlExceptionResolver;
'     nutzen dieselben Services wie REST, Token wie in ADR-06
'   - Von «geplant» zu vorhanden (BE #89): MockMarketDataProvider als Testattrappe (src/test, «Test»)
'   - Grün markiert ist nur noch, was seit v4 neu ist; die «neu»-Markierungen aus v4 sind entfernt
'   - Weiterhin geplant: AssetController.details / AssetService.findById
' Werkzeug: PlantUML

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam linetype polyline
skinparam nodesep 30
skinparam ranksep 45
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
  BackgroundColor<<geplant>> #EEEEEE
  BorderColor<<geplant>> #888888
  BackgroundColor<<neu>> #EAF4E4
}
skinparam package {
  BorderColor #666666
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #999999
}
hide circle
hide empty members
hide stereotype

title Klassendiagramm v5 – LookUpStock Backend (Sprint 4: US-01 bis US-09, ADR-06, GraphQL)

package "Präsentationsschicht (ADR-01)" as PL {
  class AuthController {
    + register(request: RegisterRequest): UserResponse
    + login(request: LoginRequest): LoginResponse
    + logout(authorization: String): void
  }
  class PortfolioController {
    + create(owner: User, request: PortfolioRequest): PortfolioResponse
    + list(owner: User): PortfolioListResponse «GET»
    + details(owner: User, portfolioId: Long): PortfolioResponse «GET»
    + update(owner: User, portfolioId: Long, request: PortfolioRequest): PortfolioResponse
    + delete(owner: User, portfolioId: Long): void
  }
  class AssetController {
    + search(q: String, limit: Integer): SearchResponse
    + stats(symbol: String, interval: String, outputSize: Integer): AssetStatsResponse
    + prices(symbol: String, interval: String, outputSize: Integer): AssetPricesResponse
    + details(assetId: Long): AssetResponse «geplant»
  }
  class SimulationController {
    + simulate(user: User, request: SimulationRequest): SimulationResponse
    + list(user: User): SavedSimulationListResponse «GET»
    + details(user: User, simulationId: Long): SimulationResponse «GET»
    + delete(user: User, simulationId: Long): void
  }
  class ComparisonController {
    + compare(user: User, request: ComparisonRequest): ComparisonResponse
  }
  class CurrentUserArgumentResolver {
    + supportsParameter(parameter: MethodParameter): boolean
    + resolveArgument(...): User
    + {static} extractToken(header: String): String
  }
  annotation CurrentUser
  class DemoController <<neu>> {
    + portfolios(): DemoPortfolioListResponse
    + simulate(request: DemoSimulationRequest): SimulationResponse
  }
  class QueryController <<neu>> {
    + searchAssets(query: String, limit: Integer): List<AssetResponse>
    + portfolios(token: String): List<PortfolioResponse>
    + portfolio(id: Long, token: String): PortfolioResponse
    + savedSimulations(token: String): List<Entry>
    + savedSimulation(id: Long, token: String): Entry
    + savedSimulationPortfolio(...): PortfolioResponse
    + savedSimulationMetrics(...): Metrics
  }
  class AuthTokenInterceptor <<neu>> {
    + TOKEN_KEY: String = "authToken"
    + intercept(request: WebGraphQlRequest, chain: Chain): Mono<WebGraphQlResponse>
  }
  class GraphQlExceptionResolver <<neu>> {
    # resolveToSingleError(ex: Throwable, env: DataFetchingEnvironment): GraphQLError
  }
}

package "Logikschicht (ADR-01)" as LL {
  class AuthService {
    ~ TOKEN_VALIDITY: Duration = 24 h
    ~ MIN_PASSWORD_LENGTH: int = 8
    ~ MAX_PASSWORD_BYTES: int = 72
    - passwordEncoder: PasswordEncoder
    - clock: Clock
    + register(email: String, password: String): User
    + login(email: String, password: String): LoginResponse
    + logout(token: String): void
    + authenticate(token: String): User
    - normalize(email: String): String
    - generateToken(): String
  }
  class PortfolioService {
    + create(request: PortfolioRequest, owner: User): Portfolio
    + findAll(owner: User): List<Portfolio>
    + findById(id: Long, owner: User): Portfolio
    + update(id: Long, request: PortfolioRequest, owner: User): Portfolio
    + delete(id: Long, owner: User): void
    - buildValidated(request: PortfolioRequest, owner: User): Portfolio
  }
  class AssetService {
    + search(query: String, limit: Integer): List<Asset>
    + getHistoricalPrices(symbol: String, interval: String, outputSize: Integer): List<PricePoint>
    + findById(id: Long): Asset «geplant»
    - findOrCreate(hit: SearchHit): Asset
  }
  class SearchCache {
    ~ TIME_TO_LIVE: Duration = 24 h
    + getOrLoad(query: String, loader: Supplier<List<SearchHit>>): List<SearchHit>
  }
  class AssetStatisticsService {
    + calculate(symbol: String, interval: String, outputSize: Integer): AssetStatsResponse
  }
  class SimulationService {
    - seedGenerator: LongSupplier
    + simulate(portfolioId: Long, parameters: SimulationParameters, owner: User): SimulationResult
    + ensureSeed(parameters: SimulationParameters): SimulationParameters
    + run(weights: List<WeightedAsset>, estimation: EstimationResult, parameters: SimulationParameters): SimulationRun
  }
  class ComparisonService {
    + ITEM_COUNT: int = 2
    - clock: Clock
    + compare(entries: List<ComparisonEntry>, parameters: SimulationParameters, owner: User): ComparisonResult
  }
  class SavedSimulationService {
    - objectMapper: ObjectMapper
    + save(result: SimulationResult, name: String, owner: User): SavedSimulation
    + findAll(owner: User): List<SavedSimulation>
    + findById(id: Long, owner: User): SavedSimulation
    + delete(id: Long, owner: User): void
    + readResult(simulation: SavedSimulation): StoredSimulationResult
  }
  class DemoService <<neu>> {
    + MAX_PATHS: int = 10000
    + portfolios(): List<DemoPortfolio>
    + simulate(portfolioId: Long, parameters: SimulationParameters): SimulationResult
    - findOrCreate(position: Position): Asset
  }
  class DemoPortfolio <<neu>> {
    + id: long
    + name: String
    + positions: List<Position>
    + {static} ALL: List<DemoPortfolio>
  }
  class "DemoPortfolio.Position" as DemoPos <<neu>> {
    + symbol: String
    + micCode: String
    + weight: BigDecimal
  }
  class ParameterEstimator {
    + MIN_MONTHS: int = 36
    + estimate(assets: List<Asset>): EstimationResult
  }
  class PriceHistoryService {
    ~ MAX_CACHE_AGE: Duration = 24 h
    ~ MONTHS_TO_LOAD: int = 120
    ~ PRICE_SCALE: int = 6
    + getMonthlyPrices(asset: Asset): List<PricePoint>
    ~ {static} completedMonths(prices: List<PricePoint>, currentMonth: YearMonth): List<PricePoint>
  }
  class PriceCache {
    + load(assetId: Long): Optional<CachedPrices>
    + replace(assetId: Long, prices: List<PricePoint>, fetchedAt: Instant): void
  }
  class MonteCarloEngine {
    + simulate(weights: List<WeightedAsset>, estimation: EstimationResult, parameters: SimulationParameters): double[][]
  }
  class MetricsCalculator {
    + percentiles(paths: double[][]): List<TimelinePoint>
    - percentile(sorted: double[], q: double): double
    + metrics(paths: double[][], parameters: SimulationParameters): Metrics
    - maxDrawdown(path: double[]): double
  }
  class User {
    - id: Long
    - email: String
    - passwordHash: String
    - createdAt: Instant
  }
  class AuthToken {
    - id: Long
    - token: String
    - createdAt: Instant
    - expiresAt: Instant
    + isExpired(now: Instant): boolean
  }
  class Portfolio {
    - id: Long
    - name: String
    - createdAt: Instant
    - updatedAt: Instant
    + addPosition(asset: Asset, weight: BigDecimal): void
    + validate(): void
    + getWeights(): List<WeightedAsset>
    + updateFrom(draft: Portfolio): void
  }
  class Position {
    - id: Long
    - weight: BigDecimal
    + getAsset(): Asset
    + getWeight(): BigDecimal
  }
  class Asset {
    - id: Long
    - symbol: String
    - isin: String
    - name: String
    - exchange: String
    - currency: String
    - type: String
    - micCode: String
  }
  class PriceHistory {
    - id: Long
    - priceDate: LocalDate
    - closePrice: BigDecimal
    - fetchedAt: Instant
  }
  class WeightedAsset <<record>> {
    + asset: Asset
    + share: BigDecimal
  }
  class SimulationParameters {
    + startCapital: Double
    + monthlyContribution: Double
    + horizonYears: Integer
    + paths: Integer = 10000
    + seed: Long
    + targetAmount: Double
    + validate(): void
    + horizonMonths(): int
    + withSeed(newSeed: long): SimulationParameters
  }
  class EstimationResult {
    + historyFrom: LocalDate
    + historyTo: LocalDate
    + estimates: List<Estimate>
    + findByAssetId(assetId: Long): Estimate
  }
  class Estimate {
    + asset: Asset
    + annualReturn: double
    + annualVolatility: double
  }
  class SimulationResult <<record>> {
    + portfolioId: Long
    + parameters: SimulationParameters
    + estimation: EstimationResult
    + timeline: List<TimelinePoint>
    + metrics: Metrics
    + runtimeMs: long
  }
  class SimulationRun {
    + timeline: List<TimelinePoint>
    + metrics: Metrics
    + endValues: double[]
  }
  class Metrics {
    + totalContributions: double
    + medianEndValue: double
    + p5EndValue: double
    + p95EndValue: double
    + valueAtRisk95: double
    + maxDrawdownMedian: double
    + targetProbability: Double
  }
  class ComparisonEntry {
    + label: String
    + portfolioId: Long
    + assetId: Long
  }
  class ComparisonResult {
    + parameters: SimulationParameters
    + estimation: EstimationResult
    + items: List<Item>
    + pairwise: List<Pairwise>
    + runtimeMs: long
    + createdAt: Instant
  }
  class "ComparisonResult.Item" as CRItem {
    + label: String
    + portfolioId: Long
    + assetId: Long
    + timeline: List<TimelinePoint>
    + metrics: Metrics
  }
  class "ComparisonResult.Pairwise" as CRPair {
    + a: int
    + b: int
    + probabilityAOutperformsB: double
  }
  class SavedSimulation {
    - id: Long
    - name: String
    - startCapital: BigDecimal
    - monthlyContribution: BigDecimal
    - horizonYears: int
    - paths: int
    - seed: long
    - targetAmount: BigDecimal
    - result: String «jsonb»
    - runtimeMs: long
    - createdAt: Instant
  }
  class TimelinePoint {
    + month: int
    + p5: double
    + p50: double
    + p95: double
  }
}

package "Datenschicht (ADR-01)" as DL {
  interface UserRepository {
    + findByEmail(email: String): Optional<User>
    + existsByEmail(email: String): boolean
  }
  interface AuthTokenRepository {
    + findByToken(token: String): Optional<AuthToken>
    + deleteByToken(token: String): long
  }
  interface PortfolioRepository {
    + findAllByOwnerOrderByCreatedAtDesc(owner: User): List<Portfolio>
    + findByIdAndOwner(id: Long, owner: User): Optional<Portfolio>
  }
  interface AssetRepository {
    + findBySymbolAndMicCode(symbol: String, micCode: String): Optional<Asset>
  }
  interface SavedSimulationRepository {
    + findAllByOwnerOrderByCreatedAtDesc(owner: User): List<SavedSimulation>
    + findByIdAndOwner(id: Long, owner: User): Optional<SavedSimulation>
  }
  interface PriceHistoryRepository {
    + findByAssetIdOrderByPriceDateAsc(assetId: Long): List<PriceHistory>
    + deleteByAssetId(assetId: Long): void
  }
  interface MarketDataProvider {
    + search(query: String): List<SearchHit>
    + getHistoricalPrices(symbol: String, micCode: String, interval: String, outputSize: int): List<PricePoint>
  }
  class TwelveDataProvider
  enum TwelveDataError {
    INVALID_KEY
    PLAN_RESTRICTED
    RATE_LIMIT
    NOT_FOUND
    OTHER
  }
  class MockMarketDataProvider <<neu>> {
    «Test» feste Kursreihen, Ausfall-Schalter
  }
  class SearchHit <<record>>
  class PricePoint <<record>> {
    + date: LocalDate
    + close: BigDecimal
  }
}

' Schichten untereinander anordnen
