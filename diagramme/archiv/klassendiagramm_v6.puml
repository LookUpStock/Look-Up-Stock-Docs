  class SavedSimulation {
    - id: Long
    - name: String
    - startCapital: BigDecimal
    - monthlyContribution: BigDecimal
    - horizonYears: int
    - paths: int
    - seed: long
    - targetAmount: BigDecimal
    - result: String «jsonb»
    - runtimeMs: long
    - createdAt: Instant
  }
  class TimelinePoint {
    + month: int
    + p5: double
    + p50: double
    + p95: double
  }
}

