@startuml klassendiagramm_v4
' LookUpStock – Klassendiagramm v4 (Backend)
' Issue Docs #129 · Sprint 4 · Stand 25.10.2026
' Grundlagen: Backend-Code (main, Stand 25.10.2026: BE #69, BE #68, BE #77, BE #87, BE #90, BE #91 gemergt),
'             Klassendiagramm v3, ADR-01 bis ADR-06, simulationsmodell.md, API-Design (Stand 25.10.2026)
' Änderungen gegenüber v3:
'   - Von «geplant» zu vorhanden: ComparisonController, ComparisonService, ComparisonResult (mit Item und Pairwise),
'     ComparisonEntry, SimulationService.run (liefert SimulationRun), MetricsCalculator.metrics und Metrics (US-05)
'   - Neu (US-08, BE #68): SavedSimulation, SavedSimulationService, SavedSimulationRepository,
'     SimulationController.list/details/delete
'   - Neu (Suchcache, BE #77): SearchCache im AssetService
'   - Neu (ADR-06, BE #91): @CurrentUser und CurrentUserArgumentResolver werten den Authorization-Header aus;
'     Controller erhalten den User als Parameter und rufen AuthService.authenticate nicht mehr selbst auf;
'     lesende Methoden als GET (list, details); TokenRequest und LogoutRequest entfernt
'   - SimulationParameters um targetAmount ergänzt (US-05, E27); SimulationService.ensureSeed öffentlich (ADR-05)
'   - PriceHistoryService liefert nur abgeschlossene Monate (E22, BE #87)
'   - Weiterhin geplant: MockMarketDataProvider (BE #89), AssetController.details / AssetService.findById
' Werkzeug: PlantUML

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam linetype polyline
skinparam nodesep 30
skinparam ranksep 45
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
  BackgroundColor<<geplant>> #EEEEEE
  BorderColor<<geplant>> #888888
  BackgroundColor<<neu>> #EAF4E4
}
skinparam package {
  BorderColor #666666
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #999999
}
hide circle
hide empty members
hide stereotype

title Klassendiagramm v4 – LookUpStock Backend (Sprint 4: US-01 bis US-08, ADR-06)

package "Präsentationsschicht (ADR-01)" as PL {
  class AuthController {
    + register(request: RegisterRequest): UserResponse
    + login(request: LoginRequest): LoginResponse
    + logout(authorization: String): void «neu»
  }
  class PortfolioController {
    + create(owner: User, request: PortfolioRequest): PortfolioResponse
    + list(owner: User): PortfolioListResponse «GET»
    + details(owner: User, portfolioId: Long): PortfolioResponse «GET»
    + update(owner: User, portfolioId: Long, request: PortfolioRequest): PortfolioResponse
    + delete(owner: User, portfolioId: Long): void
  }
  class AssetController {
    + search(q: String, limit: Integer): SearchResponse
    + stats(symbol: String, interval: String, outputSize: Integer): AssetStatsResponse
    + prices(symbol: String, interval: String, outputSize: Integer): AssetPricesResponse
    + details(assetId: Long): AssetResponse «geplant»
  }
  class SimulationController {
    + simulate(user: User, request: SimulationRequest): SimulationResponse
    + list(user: User): SavedSimulationListResponse «neu, GET»
    + details(user: User, simulationId: Long): SimulationResponse «neu, GET»
    + delete(user: User, simulationId: Long): void «neu»
  }
  class ComparisonController <<neu>> {
    + compare(user: User, request: ComparisonRequest): ComparisonResponse
  }
  class CurrentUserArgumentResolver <<neu>> {
    + supportsParameter(parameter: MethodParameter): boolean
    + resolveArgument(...): User
    + {static} extractToken(header: String): String
  }
  annotation CurrentUser <<neu>>
}

package "Logikschicht (ADR-01)" as LL {
  class AuthService {
    ~ TOKEN_VALIDITY: Duration = 24 h
    ~ MIN_PASSWORD_LENGTH: int = 8
    ~ MAX_PASSWORD_BYTES: int = 72
    - passwordEncoder: PasswordEncoder
    - clock: Clock
    + register(email: String, password: String): User
    + login(email: String, password: String): LoginResponse
    + logout(token: String): void
    + authenticate(token: String): User
    - normalize(email: String): String
    - generateToken(): String
  }
  class PortfolioService {
    + create(request: PortfolioRequest, owner: User): Portfolio
    + findAll(owner: User): List<Portfolio>
    + findById(id: Long, owner: User): Portfolio
    + update(id: Long, request: PortfolioRequest, owner: User): Portfolio «neu»
    + delete(id: Long, owner: User): void «neu»
    - buildValidated(request: PortfolioRequest, owner: User): Portfolio
  }
  class AssetService {
    + search(query: String, limit: Integer): List<Asset>
    + getHistoricalPrices(symbol: String, interval: String, outputSize: Integer): List<PricePoint>
    + findById(id: Long): Asset «geplant»
    - findOrCreate(hit: SearchHit): Asset
  }
  class SearchCache <<neu>> {
    ~ TIME_TO_LIVE: Duration = 24 h
    + getOrLoad(query: String, loader: Supplier<List<SearchHit>>): List<SearchHit>
  }
  class AssetStatisticsService {
    + calculate(symbol: String, interval: String, outputSize: Integer): AssetStatsResponse
  }
  class SimulationService {
    - seedGenerator: LongSupplier
    + simulate(portfolioId: Long, parameters: SimulationParameters, owner: User): SimulationResult
    + ensureSeed(parameters: SimulationParameters): SimulationParameters «neu»
    + run(weights: List<WeightedAsset>, estimation: EstimationResult, parameters: SimulationParameters): SimulationRun «neu»
  }
  class ComparisonService <<neu>> {
    + ITEM_COUNT: int = 2
    - clock: Clock
    + compare(entries: List<ComparisonEntry>, parameters: SimulationParameters, owner: User): ComparisonResult
  }
  class SavedSimulationService <<neu>> {
    - objectMapper: ObjectMapper
    + save(result: SimulationResult, name: String, owner: User): SavedSimulation
    + findAll(owner: User): List<SavedSimulation>
    + findById(id: Long, owner: User): SavedSimulation
    + delete(id: Long, owner: User): void
    + readResult(simulation: SavedSimulation): StoredSimulationResult
  }
  class ParameterEstimator {
    + MIN_MONTHS: int = 36
    + estimate(assets: List<Asset>): EstimationResult
  }
  class PriceHistoryService {
    ~ MAX_CACHE_AGE: Duration = 24 h
    ~ MONTHS_TO_LOAD: int = 120
    ~ PRICE_SCALE: int = 6
    + getMonthlyPrices(asset: Asset): List<PricePoint>
    ~ {static} completedMonths(prices: List<PricePoint>, currentMonth: YearMonth): List<PricePoint> «neu»
  }
  class PriceCache {
    + load(assetId: Long): Optional<CachedPrices>
    + replace(assetId: Long, prices: List<PricePoint>, fetchedAt: Instant): void
  }
  class MonteCarloEngine {
    + simulate(weights: List<WeightedAsset>, estimation: EstimationResult, parameters: SimulationParameters): double[][]
  }
  class MetricsCalculator {
    + percentiles(paths: double[][]): List<TimelinePoint>
    - percentile(sorted: double[], q: double): double
    + metrics(paths: double[][], parameters: SimulationParameters): Metrics «neu»
    - maxDrawdown(path: double[]): double «neu»
  }
  class User {
    - id: Long
    - email: String
    - passwordHash: String
    - createdAt: Instant
  }
  class AuthToken {
    - id: Long
    - token: String
    - createdAt: Instant
    - expiresAt: Instant
    + isExpired(now: Instant): boolean
  }
  class Portfolio {
    - id: Long
    - name: String
    - createdAt: Instant
    - updatedAt: Instant
    + addPosition(asset: Asset, weight: BigDecimal): void
    + validate(): void
    + getWeights(): List<WeightedAsset>
    + updateFrom(draft: Portfolio): void
  }
  class Position {
    - id: Long
    - weight: BigDecimal
    + getAsset(): Asset
    + getWeight(): BigDecimal
  }
  class Asset {
    - id: Long
    - symbol: String
    - isin: String
    - name: String
    - exchange: String
    - currency: String
    - type: String
    - micCode: String
  }
  class PriceHistory {
    - id: Long
    - priceDate: LocalDate
    - closePrice: BigDecimal
    - fetchedAt: Instant
  }
  class WeightedAsset <<record>> {
    + asset: Asset
    + share: BigDecimal
  }
  class SimulationParameters {
    + startCapital: Double
    + monthlyContribution: Double
    + horizonYears: Integer
    + paths: Integer = 10000
    + seed: Long
    + targetAmount: Double «neu»
    + validate(): void
    + horizonMonths(): int
    + withSeed(newSeed: long): SimulationParameters
  }
  class EstimationResult {
    + historyFrom: LocalDate
    + historyTo: LocalDate
    + estimates: List<Estimate>
    + findByAssetId(assetId: Long): Estimate
  }
  class Estimate {
    + asset: Asset
    + annualReturn: double
    + annualVolatility: double
  }
  class SimulationResult <<record>> {
    + portfolioId: Long
    + parameters: SimulationParameters
    + estimation: EstimationResult
    + timeline: List<TimelinePoint>
    + metrics: Metrics «neu»
    + runtimeMs: long
  }
  class SimulationRun <<neu>> {
    + timeline: List<TimelinePoint>
    + metrics: Metrics
    + endValues: double[]
  }
  class Metrics <<neu>> {
    + totalContributions: double
    + medianEndValue: double
    + p5EndValue: double
    + p95EndValue: double
    + valueAtRisk95: double
    + maxDrawdownMedian: double
    + targetProbability: Double
  }
  class ComparisonEntry <<neu>> {
    + label: String
    + portfolioId: Long
    + assetId: Long
  }
  class ComparisonResult <<neu>> {
    + parameters: SimulationParameters
    + estimation: EstimationResult
    + items: List<Item>
    + pairwise: List<Pairwise>
    + runtimeMs: long
    + createdAt: Instant
  }
  class "ComparisonResult.Item" as CRItem <<neu>> {
    + label: String
    + portfolioId: Long
    + assetId: Long
    + timeline: List<TimelinePoint>
    + metrics: Metrics
  }
  class "ComparisonResult.Pairwise" as CRPair <<neu>> {
    + a: int
    + b: int
    + probabilityAOutperformsB: double
  }
  class SavedSimulation <<neu>> {
    - id: Long
    - name: String
    - startCapital: BigDecimal
    - monthlyContribution: BigDecimal
    - horizonYears: int
    - paths: int
    - seed: long
    - targetAmount: BigDecimal
    - result: String «jsonb»
    - runtimeMs: long
    - createdAt: Instant
  }
  class TimelinePoint {
    + month: int
    + p5: double
    + p50: double
    + p95: double
  }
}

package "Datenschicht (ADR-01)" as DL {
  interface UserRepository {
    + findByEmail(email: String): Optional<User>
    + existsByEmail(email: String): boolean
  }
  interface AuthTokenRepository {
    + findByToken(token: String): Optional<AuthToken>
    + deleteByToken(token: String): long
  }
  interface PortfolioRepository {
    + findAllByOwnerOrderByCreatedAtDesc(owner: User): List<Portfolio>
    + findByIdAndOwner(id: Long, owner: User): Optional<Portfolio>
  }
  interface AssetRepository {
    + findBySymbolAndMicCode(symbol: String, micCode: String): Optional<Asset>
  }
  interface SavedSimulationRepository <<neu>> {
    + findAllByOwnerOrderByCreatedAtDesc(owner: User): List<SavedSimulation>
    + findByIdAndOwner(id: Long, owner: User): Optional<SavedSimulation>
  }
  interface PriceHistoryRepository {
    + findByAssetIdOrderByPriceDateAsc(assetId: Long): List<PriceHistory>
    + deleteByAssetId(assetId: Long): void
  }
  interface MarketDataProvider {
    + search(query: String): List<SearchHit>
    + getHistoricalPrices(symbol: String, micCode: String, interval: String, outputSize: int): List<PricePoint>
  }
  class TwelveDataProvider
  enum TwelveDataError {
    INVALID_KEY
    PLAN_RESTRICTED
    RATE_LIMIT
    NOT_FOUND
    OTHER
  }
  class MockMarketDataProvider <<geplant>>
  class SearchHit <<record>>
  class PricePoint <<record>> {
    + date: LocalDate
    + close: BigDecimal
  }
}

' Schichten untereinander anordnen
PL -[hidden]down- LL
LL -[hidden]down- DL
Asset -[hidden]down- UserRepository
TimelinePoint -[hidden]down- MarketDataProvider

' Anmeldung zentral (ADR-06)
CurrentUserArgumentResolver ..> AuthService : authenticate(token)
CurrentUserArgumentResolver ..> CurrentUser
CurrentUserArgumentResolver ..> User : liefert
AuthController ..> CurrentUserArgumentResolver : extractToken()

' Präsentation -> Logik
AuthController --> AuthService
PortfolioController --> PortfolioService
AssetController --> AssetService
AssetController --> AssetStatisticsService
SimulationController --> SimulationService
SimulationController --> SavedSimulationService
ComparisonController --> ComparisonService

' Anmeldung (US-01)
AuthService --> UserRepository
AuthService --> AuthTokenRepository
AuthService ..> User : <<create>>
AuthService ..> AuthToken : <<create>>
AuthToken "0..*" --> "1" User : user

' Portfolio (US-03, US-06)
PortfolioService --> PortfolioRepository
PortfolioService --> AssetRepository
PortfolioService ..> Portfolio : <<create>>
Portfolio "0..*" --> "1" User : owner
Portfolio "1" *-- "1..*" Position : enthält
Position "0..*" --> "1" Asset : bezieht sich auf
Portfolio ..> WeightedAsset : <<create>>
WeightedAsset --> "1" Asset

' Suche und Statistik (US-02)
AssetService --> MarketDataProvider
AssetService --> AssetRepository
AssetService --> SearchCache
AssetStatisticsService --> MarketDataProvider

' Simulation (US-04, ADR-02)
SimulationService --> PortfolioService
SimulationService --> ParameterEstimator
SimulationService --> MonteCarloEngine
SimulationService --> MetricsCalculator
SimulationService ..> SimulationResult : <<create>>
SimulationService ..> SimulationParameters : withSeed()
SimulationService ..> SimulationRun : <<create>>
MetricsCalculator ..> Metrics : <<create>>
SimulationResult --> "1" Metrics
MonteCarloEngine ..> EstimationResult
MonteCarloEngine ..> SimulationParameters
MetricsCalculator ..> TimelinePoint : <<create>>
SimulationResult "1" *-- "1..*" TimelinePoint
EstimationResult "1" *-- "1..*" Estimate
ParameterEstimator ..> EstimationResult : <<create>>

' Vergleich (US-07, ADR-05)
ComparisonService --> PortfolioService
ComparisonService --> AssetRepository
ComparisonService --> ParameterEstimator
ComparisonService --> SimulationService : run()
ComparisonService ..> ComparisonResult : <<create>>
ComparisonService ..> ComparisonEntry
ComparisonResult "1" *-- "2" CRItem
ComparisonResult "1" *-- "1..*" CRPair
CRItem --> "1" Metrics

' Gespeicherte Simulationen (US-08)
SavedSimulationService --> SavedSimulationRepository
SavedSimulationService --> PortfolioService
SavedSimulationService ..> SavedSimulation : <<create>>
SavedSimulation "0..*" --> "1" User : owner
SavedSimulation "0..*" --> "1" Portfolio : portfolio

' Kursdaten und Cache (NF-07, NF-08, NF-12)
ParameterEstimator --> PriceHistoryService
PriceHistoryService --> MarketDataProvider
PriceHistoryService --> PriceCache
PriceCache --> PriceHistoryRepository
PriceCache --> AssetRepository
PriceHistory "0..*" --> "1" Asset
TwelveDataProvider ..|> MarketDataProvider
MockMarketDataProvider ..|> MarketDataProvider
TwelveDataProvider ..> TwelveDataError
TwelveDataProvider ..> SearchHit : <<create>>
TwelveDataProvider ..> PricePoint : <<create>>

note right of AuthService
  <b>Anmeldung (US-01)</b>
  register: E-Mail klein geschrieben (E11), Format (E12),
  Passwort ≥ 8 Zeichen, nur BCrypt-Hash speichern (NF-03)
  login: gleiche Meldung bei falscher E-Mail und
  falschem Passwort; Token 24 h gültig (NF-16)
  authenticate: liefert den User zum Token oder 401
  Uhr (Clock) austauschbar für Tests (AT-01-10)
end note

note bottom of PortfolioService
  <b>Zugriffsschutz (NF-04, ADR-04, ADR-06)</b>
  arbeitet nur mit Portfolios des übergebenen
  Nutzers (findByIdAndOwner); fremde ID → 404,
  auch bei update/delete (US-06)
end note

note bottom of MonteCarloEngine
  <b>Simulationsmodell v2 (E15, E18, E23)</b>
  je Anlage μ = annualReturn / 12, σ = annualVolatility / √12;
  Zufallszahl je Anlage und Monat, unabhängig (keine Korrelation);
  Gewichte jeden Monat zurückgesetzt (Rebalancing);
  Wert = max(0, Wert · (1 + R)) + Sparrate am Monatsende;
  je Aufruf neues Random(seed) (NF-08, Vergleich ADR-05)
end note

note bottom of MetricsCalculator
  p5, p50, p95 je Monat,
  lineare Interpolation (QUANTIL.INKL);
  metrics(): Einzahlungen, Endwerte (p5, p50, p95),
  Value at Risk 95 %, max. Drawdown des Medianpfads,
  Zielwahrscheinlichkeit bei Zielbetrag (US-05, E24–E27)
end note

note right of SimulationService
  <b>GRASP Controller (ADR-02)</b>
  koordiniert, rechnet nicht selbst:
  Eingaben prüfen → eigenes Portfolio laden (404) →
  Seed festlegen (NF-08) → schätzen (422/503) →
  simulieren → Perzentile berechnen
end note

note right of ComparisonService
  <b>GRASP Controller + Creator (ADR-05)</b>
  genau 2 Einträge (Portfolio oder Anlage = 100 %);
  ein Seed für alle Einträge, eine gemeinsame
  Schätzung über alle Anlagen (E17);
  je Eintrag SimulationService.run()
end note

note bottom of PriceHistoryService
  <b>Kursdaten-Cache (NF-07)</b>
  jünger als 24 h → aus price_history,
  sonst Abruf bei Twelve Data (120 Monatswerte)
  und Ersetzen im Cache; nicht erreichbar → 503.
  Frische Kurse auf 6 Nachkommastellen
  gerundet wie die Spalte (F4, NF-08).
  Nur abgeschlossene Monate (E22, BE #87);
  der Cache speichert Rohdaten, gefiltert
  wird beim Lesen
end note

note right of CurrentUserArgumentResolver
  <b>Anmeldung zentral (ADR-06)</b>
  liest Authorization: Bearer <token>;
  fehlt der Header oder ist der Token
  ungültig → 401; sonst User über
  AuthService.authenticate (ADR-04)
  GRASP Pure Fabrication
end note

note bottom of SavedSimulationService
  <b>Gespeicherte Simulation (US-08)</b>
  speichert Parameter und Ergebnis
  (JSON in simulation.result, jsonb);
  readResult() ohne Neuberechnung;
  nur eigene Einträge (findByIdAndOwner, NF-04)
end note

note bottom of PriceCache
  replace() in eigener Transaktion
  (REQUIRES_NEW): Cache bleibt erhalten,
  auch wenn die Simulation danach mit
  422 abbricht
end note

note bottom of ParameterEstimator
  je Anlage mind. 36 Monatswerte (E8);
  ohne Kurse und zu kurze Historie werden
  getrennt mit allen Anlagen gemeldet
  (E6, 422, F3); gemeinsamer Schätzzeitraum
  (E17); Rendite = 12 · Mittel,
  Volatilität = Std.-Abw. · √12
end note

note bottom of TwelveDataError
  401 INVALID_KEY, 429 RATE_LIMIT → 503;
  403 PLAN_RESTRICTED, 400/404 NOT_FOUND
  → keine Kurse (leere Liste) (F3)
end note

note bottom of Portfolio
  <b>GRASP Information Expert (ADR-03)</b>
  validate(): Regeln E1, E2, E9 (Name, Gewichtungen, Summe 100 %)
  updateFrom(): übernimmt einen geprüften Entwurf; bleibende
  Positionen werden geändert statt neu angelegt
  (UNIQUE portfolio_id, asset_id)
end note

legend bottom left
  <b>Legende</b>
  Weiß = bereits in v3 vorhanden · <back:#EAF4E4> Grün </back> bzw. «neu» = seit v3 umgesetzt (Backend main, 25.10.2026) · «GET» = lesender Endpunkt per GET (ADR-06)
  Grau «geplant» = noch nicht umgesetzt (BE #89 Mock) · «geplant» hinter einer Methode = Klasse vorhanden, Methode folgt
  Anmeldung (ADR-06): Geschützte Controller-Methoden erhalten den angemeldeten User über @CurrentUser; die Logikschicht bekommt nur den User.
  Nicht dargestellt: DTOs (…Request, …Response, StoredSimulationResult), Exceptions (u. a. InsufficientDataException → 422) und GlobalExceptionHandler,
  Konfiguration (CorsConfig, ClockConfig, PasswordConfig, WebConfig registriert den Resolver), Health-/PingController, Twelve-Data-DTOs.
  Vorversion: diagramme/archiv/klassendiagramm_v3
endlegend

@enduml
